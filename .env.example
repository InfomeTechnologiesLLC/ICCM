# Copy this file to .env and fill in real values before deploying.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------
# DB_ENGINE=sqlite (default, zero setup) or DB_ENGINE=mysql
DB_ENGINE=sqlite

# Only read when DB_ENGINE=mysql:
DB_NAME=india_church_mission
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

TIME_ZONE=Asia/Kolkata
MAX_UPLOAD_SIZE_MB=8

# Optional: where contact-form notification emails would be sent if you
# wire up an email backend.
CONTACT_NOTIFICATION_EMAIL=
